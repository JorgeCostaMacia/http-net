<Project>

	<!-- Central Package Management: all third-party package versions live here, in one place.
	     Cross-repo deps on the shared-net foundation (JorgeCostaMacia.Exception / GuidFactory /
	     Serilog) are PackageReferences to the published packages, versioned here too. Inter-package
	     JorgeCostaMacia.Http.* deps (same repo) are ProjectReferences (lockstep versioning); pack
	     emits them as nuspec <dependency> at the shared version, so CPM doesn't manage them. -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Asp.Versioning.Http" Version="8.1.1" />
		<PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
		<PackageVersion Include="JorgeCostaMacia.Exception" Version="3.0.1" />
		<PackageVersion Include="JorgeCostaMacia.GuidFactory" Version="3.0.1" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
		<!-- Pins the transitive Microsoft.OpenApi above the vulnerable 2.0.0 that AspNetCore.OpenApi pulls on net10 (GHSA-v5pm-xwqc-g5wc); inert on net8/9, which don't reference it. Needs CentralPackageTransitivePinningEnabled. -->
		<PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
		<PackageVersion Include="Serilog" Version="4.3.1" />
		<PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
		<PackageVersion Include="xunit.v3" Version="3.2.2" />
	</ItemGroup>

	<!-- Asp.Versioning 10 is net10-only; net8/net9 must stay on 8.1.1. Give the net10 build the latest,
	     keep 8.1.1 for the down-level targets so the packages keep multi-targeting net8;net9;net10. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageVersion Update="Asp.Versioning.Http" Version="10.0.0" />
		<PackageVersion Update="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
	</ItemGroup>

</Project>
