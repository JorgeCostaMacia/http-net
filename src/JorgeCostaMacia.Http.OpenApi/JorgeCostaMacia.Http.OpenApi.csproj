<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net10-only: uses the native Microsoft.AspNetCore.OpenApi (10.x) generation pipeline -->
		<TargetFrameworks>net10.0</TargetFrameworks>
		<Description>RFC 7807 ProblemDetails schema transformer for native .NET OpenAPI (errors, requestId, traceId, aggregate metadata), applied from the host's AddOpenApi</Description>
		<PackageTags>http,openapi,swagger,problemdetails,aspnetcore,schema</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
	</ItemGroup>

</Project>
