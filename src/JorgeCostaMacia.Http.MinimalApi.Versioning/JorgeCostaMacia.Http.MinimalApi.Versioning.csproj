<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>API versioning for Minimal APIs via URL segments (e.g. /v1/resource), wired from an 'ApiVersion' configuration value</Description>
		<PackageTags>http,versioning,api,minimalapi,aspnetcore,url</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Http" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
	</ItemGroup>

</Project>
