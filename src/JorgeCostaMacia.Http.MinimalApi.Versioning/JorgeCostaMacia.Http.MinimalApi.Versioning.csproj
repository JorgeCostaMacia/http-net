<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Default API-versioning policy for Minimal APIs via URL segments (e.g. /v1/resource), as options extensions applied from the host's AddApiVersioning/AddApiExplorer</Description>
		<PackageTags>http,versioning,api,minimalapi,aspnetcore,url</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Http" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
	</ItemGroup>

</Project>
